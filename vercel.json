{
  "crons": [
    {
      "path": "/api/alerts/send",
      "schedule": "0 14 * * 1-5"
    },
    {
      "path": "/api/brief",
      "schedule": "0 13 * * 1-5"
    }
  ],
  "functions": {
    "api/**/*.js": {
      "maxDuration": 30
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/static/(.*)",
      "dest": "/static/$1"
    },
    {
      "src": "/(.*\\.(js|css|ico|png|svg|jpg|jpeg|woff|woff2|ttf|map|webmanifest|txt))",
      "dest": "/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
