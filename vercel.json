{
  "crons": [
    {
      "path": "/api/alerts/send",
      "schedule": "0 14 * * 1-5"
    }
  ],
  "functions": {
    "api/**/*.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
{
  "crons": [
    {
      "path": "/api/alerts/send",
      "schedule": "0 14 * * 1-5"
    },
    {
      "path": "/api/brief",
      "schedule": "0 13-21 * * 1-5"
    }
  ]
}
