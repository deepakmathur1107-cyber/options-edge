{
  "crons": [
    {
      "path": "/api/alerts/send",
      "schedule": "0 14 * * 1-5"
    },
    {
      "path": "/api/brief",
      "schedule": "0 13 * * 1-5"
    },
    {
      "path": "/api/cron/scan?tf=Quick (5–14 DTE)",
      "schedule": "*/15 13-20 * * 1-5"
    },
    {
      "path": "/api/cron/scan?tf=Swing (21–45 DTE)",
      "schedule": "*/15 13-20 * * 1-5"
    },
    {
      "path": "/api/cron/scan?tf=LEAP (90–180 DTE)",
      "schedule": "0 13-20 * * 1-5"
    },
    {
      "path": "/api/cron/scan?tf=Deep LEAP (180–365 DTE)",
      "schedule": "0 13-20 * * 1-5"
    }
  ],
  "functions": {
    "api/**/*.js": {
      "maxDuration": 30
    },
    "api/cron/scan.js": {
      "maxDuration": 280
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
